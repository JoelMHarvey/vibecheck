{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/visibility.py": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/badge/:check.svg", "destination": "/api/badge?check=:check" },
    { "source": "/.well-known/vibecheck-key", "destination": "/api/key" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
